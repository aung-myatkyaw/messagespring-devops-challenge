# --- Secrets & credentials: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*-sa-key.json
credentials.json
kubeconfig*

# --- Terraform / OpenTofu ---
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# .terraform.lock.hcl IS committed for roots (pins provider checksums), but not
# for reusable modules: the root that calls a module decides provider versions.
infra/modules/**/.terraform.lock.hcl

# --- Node / Next.js ---
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*

# --- OS / editor ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
