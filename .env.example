# Local overrides for docker compose. Copy to .env (git-ignored) and adjust.
# This service needs no secrets. Real secrets never go in .env files in this repo:
# CI reads them from the GitHub Actions secret store, and the cluster gets them
# from SSM Parameter Store via External Secrets.

# Host port mapped to the container's port 3000.
HOST_PORT=3000

# Version reported by /api/health and stamped on the image (CI uses the git commit SHA).
APP_VERSION=local
