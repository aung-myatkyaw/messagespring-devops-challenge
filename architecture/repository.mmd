---
# Fixed seed: the default look draws some shapes with random curves, so
# without it every render would produce a different file.
config:
  handDrawnSeed: 1
---
%% How the repository is organised, and why. One folder per concern; each
%% environment is a folder or a values file, never a branch.
%% Rendered by render.sh into repository.svg.
flowchart LR
    repo(["repository root<br/>docker-compose.yml, .env.example<br/>README.md, ARCHITECTURE.md"])

    repo --> app["application/<br/>Next.js app + Dockerfile<br/><i>one image, built once</i>"]
    repo --> infra["infra/<br/>Terraform"]
    repo --> k8s["k8s/<br/>everything Argo CD deploys"]
    repo --> gh[".github/<br/>workflows, terraform-init action,<br/>dependabot.yml"]
    repo --> scripts["scripts/<br/>shared by CI and laptops:<br/>validate-k8s, set-image,<br/>set-env-values, install-ci-tools"]
    repo --> docs["architecture/ + docs/runbooks/<br/>diagrams as code, procedures"]

    infra --> bootstrap["bootstrap/<br/>state bucket + KMS key<br/><i>local state, run once</i>"]
    infra --> modules["modules/<br/>network, eks-cluster, log-storage,<br/>dns-tls, ecr, github-oidc,<br/>argocd-bootstrap<br/><i>secure defaults, few inputs</i>"]
    infra --> envs["envs/"]
    envs --> shared["shared/<br/>ECR, GitHub OIDC roles<br/><i>account-wide, one copy</i>"]
    envs --> devprod["dev/ and prod/<br/>identical code; terraform.tfvars<br/>is the whole difference"]
    devprod --> envboot["&lt;env&gt;/bootstrap/<br/>installs Argo CD once<br/><i>run by a person, not CI</i>"]

    k8s --> argocd["argocd/<br/>projects/ + envs/&lt;env&gt;/<br/><i>one Application per component<br/>per environment</i>"]
    k8s --> charts["charts/<br/>web (our app),<br/>karpenter-nodes"]
    k8s --> platform["platform/&lt;component&gt;/<br/>values.yaml + values-&lt;env&gt;.yaml<br/>for upstream charts, namespaces"]

    classDef top fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
    classDef human fill:#fff4e5,stroke:#ef6c00,color:#5d3a00
    class app,infra,k8s,gh,scripts,docs top
    class bootstrap,envboot human
